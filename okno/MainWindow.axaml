<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="okno.MainWindow"
        Title="okno"
        CanResize="False"
        RequestedThemeVariant="Dark">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WarsztatBg">Black</SolidColorBrush>
                    <SolidColorBrush x:Key="WarsztatFg">White</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WarsztatBg">White</SolidColorBrush>
                    <SolidColorBrush x:Key="WarsztatFg">Black</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <TextBlock Text="Technikum technologii cyfrowych"
                   FontWeight="Bold"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="15" />

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
            <TextBlock Text="Warsztat"
                       Foreground="{DynamicResource WarsztatFg}"
                       Background="{DynamicResource WarsztatBg}"
                       Padding="10,5"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="DateTimeTextBlock"
                       FontSize="16"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="Zadanie 2.3"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="15" />
    </Grid>
</Window>
